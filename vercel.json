{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/tick.py": {
      "maxDuration": 60
    },
    "api/status.py": {
      "maxDuration": 30
    },
    "api/best.py": {
      "maxDuration": 30
    },
    "api/submit.py": {
      "maxDuration": 60
    }
  }
}